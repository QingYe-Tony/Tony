{
  "name": "merchant-pos",
  "version": "1.7.0",
  "description": "跨平台商户收银系统（桌面版，基于 Electron 打包）",
  "main": "main.js",
  "author": "WorkBuddy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node icons.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "web:copy": "node scripts/copy-web.js",
    "cap:sync": "npm run web:copy && npx cap sync android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "com.workbuddy.pos",
    "productName": "通用收银台",
    "copyright": "Copyright © 2026 WorkBuddy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "icon.svg",
      "icon-192.png",
      "icon-512.png",
      "icon-maskable-512.png",
      "apple-touch-icon.png",
      "main.js",
      "preload.js",
      "sync-server/server.js"
    ],
    "icon": "build/icon",
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://REPLACE-THIS.example.com/releases/"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "workbuddy",
      "synopsis": "跨平台商户收银系统"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "@capacitor/core": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  }
}
